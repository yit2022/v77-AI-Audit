# Copy to .env on the Contabo host (chmod 600). Never commit .env.
# Prefer values from: /workspace/V77 aI Auditor/deploy-secrets.txt (or your vault copy)

NODE_ENV=production
HOSTNAME=0.0.0.0
PORT=3000

# Postgres (compose service "db")
POSTGRES_USER=v77
POSTGRES_PASSWORD=REPLACE_WITH_STRONG_DB_PASSWORD
POSTGRES_DB=v77
# DATABASE_URL is assembled by docker-compose; override only if needed:
# DATABASE_URL=postgres://v77:REPLACE_WITH_STRONG_DB_PASSWORD@db:5432/v77

# Seed / auth — demo1234 is disabled in production
DISABLE_DEMO_PASSWORDS=true
V77_ADMIN_PASSWORD=REPLACE_WITH_STRONG_ADMIN_PASSWORD
# Optional distinct passwords (default to V77_ADMIN_PASSWORD):
# V77_OWNER_PASSWORD=
# V77_AUDITOR_PASSWORD=

# Sessions / misc
V77_SESSION_SECRET=REPLACE_WITH_RANDOM_HEX
V77_DATA_DIR=/data

# AI: mock only — leave provider keys unset to avoid spend
AI_PROVIDER=mock
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# AZURE_OPENAI_API_KEY=

# Public origin (no trailing slash). Used for invite links.
V77_APP_ORIGIN=https://v77trust.com


# SSO (OIDC / SAML scaffolding — no paid IdP required)
# V77_SSO_ENABLED=true
# OIDC_ISSUER=
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# OIDC_REDIRECT_URI=https://v77trust.com/api/auth/oidc/callback
# V77_SAML_ENABLED=false
# V77_SAML_SP_ENTITY_ID=
# V77_SAML_ACS_URL=
# V77_SAML_IDP_ENTITY_ID=
# V77_SAML_IDP_SSO_URL=
# V77_SAML_IDP_CERTIFICATE=

# Platform owner super-console allowlist (comma-separated). Default: admin@v77.local
# V77_PLATFORM_ADMIN_EMAILS=admin@v77.local

# Workers AI / real providers (default false = mock fallback)
# V77_ENABLE_REAL_PROVIDERS=false
